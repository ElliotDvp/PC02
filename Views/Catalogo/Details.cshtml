@model PC02.Models.Inmueble

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <h2 class="card-title text-primary fw-bold mb-3">
                @Model.Titulo
            </h2>
            <p class="text-muted mb-1">
                <i class="bi bi-geo-alt-fill text-danger"></i> @Model.Ciudad – @Model.Direccion
            </p>
            <p class="mb-2">
                <span class="badge bg-info text-dark">Tipo: @Model.Tipo</span>
            </p>
            <h4 class="text-success fw-bold mb-3">
                $ @Model.Precio.ToString("N0")
            </h4>
            <p class="mb-4">
                <i class="bi bi-house-door-fill"></i> Dormitorios: <strong>@Model.Dormitorios</strong> &nbsp;|&nbsp; 
                <i class="bi bi-droplet-half"></i> Baños: <strong>@Model.Banos</strong>
            </p>

            <form asp-controller="Visita" asp-action="Create" method="get">
                <input type="hidden" name="inmuebleId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                    <i class="bi bi-calendar-check me-2"></i> Agendar visita
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons (si aún no lo tienes en el layout) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
