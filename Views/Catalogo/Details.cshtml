@model PC02.Models.InmuebleDetailViewModel
<h2>@Model.Inmueble.Titulo</h2>
<p>@Model.Inmueble.Ciudad – @Model.Inmueble.Direccion</p>

@if (Model.Feedback != null)
{
  var cls = Model.Success ? "alert-success" : "alert-danger";
  <div class="alert @cls">@Model.Feedback</div>
}

<h4>Agendar visita</h4>
<form asp-controller="Visita" asp-action="Create" method="post">
  <input type="hidden" asp-for="VisitaInput.InmuebleId" />
  <div>
    <label asp-for="VisitaInput.FechaInicio"></label>
    <input asp-for="VisitaInput.FechaInicio" type="datetime-local" />
    <span asp-validation-for="VisitaInput.FechaInicio"></span>
  </div>
  <div>
    <label asp-for="VisitaInput.FechaFin"></label>
    <input asp-for="VisitaInput.FechaFin" type="datetime-local" />
    <span asp-validation-for="VisitaInput.FechaFin"></span>
  </div>
  <div>
    <label asp-for="VisitaInput.Notas"></label>
    <textarea asp-for="VisitaInput.Notas"></textarea>
  </div>
  <button type="submit">Agendar visita</button>
</form>

<hr />

@if (!Model.HasActiveReservation)
{
  <form asp-controller="Reserva" asp-action="Create" method="post">
    <input type="hidden" name="inmuebleId" value="@Model.Inmueble.Id" />
    <button type="submit">Reservar ahora (48h)</button>
  </form>
}
else
{
  <div class="alert alert-info">Ya hay una reserva activa</div>
}

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
